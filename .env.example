# Copy to `.env` and adjust as needed.
# docker-compose.yml reads this file automatically (same keys apply).

# --- Ports (compose only) ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Cloud hosts (HF Spaces / Railway / Render) inject PORT; the start scripts
# honour it with fallback to BACKEND_PORT then 8000. Leave unset locally.
# PORT=7860

# --- Backend ---
# SQLAlchemy database URL. In docker-compose the backend service overrides
# this to point at the `ibvap_data` volume (SQLite). Locally, if you leave
# DATABASE_URL unset, the backend falls back to ibvap.db.
# Free-cloud note: without a persistent volume SQLite resets on restart.
DATABASE_URL=sqlite:///./data/ibvap.db

# Comma-separated list of origins allowed by the backend CORS policy.
# Same-origin via nginx needs no CORS entry, but Vercel/split deploys do:
#   CORS_ORIGINS=https://<your-frontend>.vercel.app
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Split deploy only: point the compose-built frontend at an external backend.
# Leave empty for same-origin (nginx proxies /api + /ws to backend:8000).
VITE_API_URL=
VITE_WS_URL=

# --- Demo mode (Hugging Face free demo) ---
# 1 = seed a video-file demo stream on boot, never autostart webcam/localhost
# RTSP sources (they don't exist on cloud hosts). RTSP support stays in the
# code — this only changes what the server starts by itself.
IBVAP_DEMO_MODE=0
# 0 = skip autostart entirely (cheap boot on hosts that sleep/restart often).
IBVAP_AUTOSTART_STREAMS=1
IBVAP_DEMO_VIDEO=samples/demo.mp4
IBVAP_DEMO_STREAM_NAME=demo-video-file
# Capabilities seeded on the demo stream (keep light for free CPU).
IBVAP_DEMO_CAPABILITIES=detection,tracking

# --- Optional heavyweight capabilities (env gates, nothing is removed) ---
# Set to 0 on tiny free hosts so DeepFace/TF + MediaPipe are never imported
# at runtime (endpoints return HTTP 503 with an explanation instead).
# Full functionality returns with =1 + full install (VPS / Render paid).
IBVAP_ENABLE_FACE=1
IBVAP_ENABLE_POSE=1
IBVAP_ENABLE_ANPR=1

# --- Inference / pipeline tuning ---
YOLO_MODEL=yolov8n.pt
# Directory Ultralytics uses to cache downloaded weights (ephemeral on free
# Spaces without persistent storage — re-downloads ~6 MB after restart).
# YOLO_MODEL_DIR=/app/data/models
YOLO_IMGSZ=640
YOLO_THREADS=4
PROCESS_EVERY_N_FRAMES=5
RTSP_RECONNECT_DELAY=2
PERSIST_INTERVAL_SECONDS=10

# --- Face watchlist (SQLite file shared by /watchlist API + WatchlistManager) ---
WATCHLIST_DB=data/watchlist.db


