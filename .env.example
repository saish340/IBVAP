# Copy to `.env` and adjust as needed.
# docker-compose.yml reads this file automatically (same keys apply).

# --- Backend ---
# SQLAlchemy database URL. In docker-compose the backend service overrides
# this to point at the `db` container. Locally, if you leave DATABASE_URL
# unset, the backend falls back to a zero-config SQLite file (ibvap.db).
DATABASE_URL=postgresql+psycopg2://ibvap:ibvap@localhost:5432/ibvap

# Comma-separated list of origins allowed by the backend CORS policy
CORS_ORIGINS=http://localhost:5173

# --- Postgres (used by the `db` service in docker-compose) ---
POSTGRES_USER=ibvap
POSTGRES_PASSWORD=ibvap
POSTGRES_DB=ibvap

# --- Inference / pipeline tuning ---
YOLO_MODEL=yolov8n.pt
PROCESS_EVERY_N_FRAMES=5
RTSP_RECONNECT_DELAY=2
PERSIST_INTERVAL_SECONDS=10

# --- Face watchlist (SQLite file shared by /watchlist API + WatchlistManager) ---
WATCHLIST_DB=watchlist.db
