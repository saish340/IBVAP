# Copy to `.env` and adjust as needed.
# docker-compose.yml reads this file automatically (same keys apply).

# --- Ports (compose only) ---
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Backend ---
# SQLAlchemy database URL. In docker-compose the backend service overrides
# this to point at the `ibvap_data` volume (SQLite). Locally, if you leave
# DATABASE_URL unset, the backend falls back to ibvap.db.
DATABASE_URL=sqlite:///./data/ibvap.db

# Comma-separated list of origins allowed by the backend CORS policy.
# Same-origin via nginx needs no CORS entry, but Vercel/split deploys do:
#   CORS_ORIGINS=https://<your-frontend>.vercel.app
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Split deploy only: point the compose-built frontend at an external backend.
# Leave empty for same-origin (nginx proxies /api + /ws to backend:8000).
VITE_API_URL=
VITE_WS_URL=

# --- Inference / pipeline tuning ---
YOLO_MODEL=yolov8n.pt
PROCESS_EVERY_N_FRAMES=5
RTSP_RECONNECT_DELAY=2
PERSIST_INTERVAL_SECONDS=10

# --- Face watchlist (SQLite file shared by /watchlist API + WatchlistManager) ---
WATCHLIST_DB=data/watchlist.db

