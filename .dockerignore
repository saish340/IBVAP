# Keep cloud build contexts small — demo videos + local artefacts never
# belong in an image. (Model weights download on first use and are cached.)
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.git/
*.log
*.db
*.sqlite3
*.pt
*.onnx
*.engine
models/
samples/
tools/
demo/
ppt_visual_results/
test_results/
frontend/node_modules/
frontend/dist/
*.mp4
*.webm
*.jpg
.env
